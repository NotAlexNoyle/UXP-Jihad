toolkit = CONFIG['MOZ_WIDGET_TOOLKIT']

DIRS += ['ipc']

if CONFIG['NS_PRINTING']:
    if toolkit == 'windows':
        DIRS += ['win']
    elif toolkit == 'cocoa':
        DIRS += ['mac']
    elif CONFIG['MOZ_PDF_PRINTING'] or toolkit == 'headless':
        # Jihad headless: reuse the gtk-free PDF printing prompt service.
        DIRS += ['unixshared']
