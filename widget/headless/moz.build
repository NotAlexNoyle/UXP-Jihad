# Jihad: headless (no X/GTK) widget backend. The widget itself is the shared
# PuppetWidget (widget/PuppetWidget.cpp); this dir supplies the app shell and
# the component factory.
UNIFIED_SOURCES += [
    'GfxInfo.cpp',
    'nsAppShell.cpp',
    'nsLookAndFeel.cpp',
    'nsWidgetFactory.cpp',
]

include('/ipc/chromium/chromium-config.mozbuild')

FINAL_LIBRARY = 'xul'

LOCAL_INCLUDES += [
    '/widget',
]
